<server>
  <featureManager>
    <feature>servlet-4.0</feature>
    <feature>jsp-2.3</feature>
    <feature>cdi-2.0</feature>
    <feature>el-3.0</feature>
  </featureManager>

  <httpEndpoint id="defaultHttpEndpoint" httpPort="9080" httpsPort="9443"/>

  <!-- Struts2 showcase 6.6.0 (Java EE 8 - uses javax.* packages) -->
  <webApplication id="struts2-showcase" location="struts2-showcase.war" contextRoot="/"/>
  
  <!-- Increase startup timeout for large applications -->
  <applicationManager startTimeout="5m"/>
</server>
